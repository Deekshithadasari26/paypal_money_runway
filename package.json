{
  "name": "money-runway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src server tests vite.config.js package.json index.html",
    "postman:generate": "node scripts/generate-postman.mjs",
    "test:postman": "node scripts/test-postman.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "test:production": "npm run build && node scripts/test-production.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
