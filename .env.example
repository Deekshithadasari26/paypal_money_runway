PORT=3001
DATABASE_PATH=./data/money-runway.sqlite
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
# Optional: only needed for the invoice draft
PAYPAL_INVOICER_EMAIL=YOUR_SANDBOX_BUSINESS_EMAIL
# Choose gemini or openai. Keys stay on the backend.
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=YOUR_AI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
# Hosted judge demo. Local defaults remain loopback with no login.
# Production requires a long DEMO_PASSWORD. Set secrets in Render's environment.
# HOST=0.0.0.0
# APP_ORIGIN=https://YOUR_SERVICE.onrender.com
# DEMO_USERNAME=judge
# DEMO_PASSWORD=YOUR_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
# DEMO_SEED_DATE=2026-11-10
