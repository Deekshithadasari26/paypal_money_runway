{
  "info": {
    "name": "PayPal Money Runway · judge checks",
    "description": "Read-only checks run by default. Mutating sample checks require runMutations=true and must target a disposable local demo. Real Sandbox sync requires runLivePayPal=true; real paid model calls require runLiveAI=true. API secrets stay in the backend environment; this collection never requests or prints OAuth tokens, client secrets, or AI keys. No invoice approval or payment request is included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{demoUsername}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{demoPassword}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 · Read-only app checks",
      "item": [
        {
          "name": "01 Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Health ready',()=>pm.expect(d.status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Integration configuration (no secrets)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/integrations/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Only safe status fields',()=>pm.expect(Object.keys(d).sort()).to.eql(['aiConfigured','paypalConfigured','paypalLastSync'].sort()));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Today and integer money",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/today"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Allowance arithmetic',()=>{pm.expect(Number.isSafeInteger(d.spent)).to.eql(true);pm.expect(d.left).to.eql(d.allowance-d.spent);});",
                  "pm.test('INR cash ledger only',()=>d.transactions.forEach(t=>{pm.expect(t.currency).to.eql('INR');pm.expect(t.source.startsWith('PayPal')).to.eql(false);}));",
                  "if(String(pm.environment.get('expectSeed'))==='true')pm.test('Seeded 300 rupees remaining',()=>pm.expect(d.left).to.eql(30000));",
                  "pm.collectionVariables.set('demoDate',d.date);pm.collectionVariables.set('baselineLeft',d.left);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Payday plan reconciliation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/plan"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "const t=d.projection.totals;pm.test('Exact end-date cash equation',()=>pm.expect(d.projection.projected).to.eql(t.opening+t.actualIncome-t.actualOutflow+t.plannedIncome-t.plannedOutflow-t.estimatedOutflow));",
                  "if(String(pm.environment.get('expectSeed'))==='true')pm.test('Seeded salary savings 18000 rupees',()=>pm.expect(d.savings).to.eql(1800000));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Forecast and delayed-income scenario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/forecast"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Thirty daily points',()=>{pm.expect(d.base.length).to.eql(30);pm.expect(d.delayed.length).to.eql(30);d.base.forEach(p=>pm.expect(Number.isSafeInteger(p.balance)).to.eql(true));});",
                  "pm.test('Buffer-safe extra capacity',()=>pm.expect(d.extra).to.eql(Math.max(0,Math.min(d.cash,d.baseMinimum)-d.buffer)));",
                  "if(String(pm.environment.get('expectSeed'))==='true')pm.test('Delay produces November 12 shortfall',()=>pm.expect(d.delayedShortfall.date).to.eql('2026-11-12'));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Calendar daily math",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calendar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Calendar month length',()=>pm.expect(d.days.length).to.be.within(28,31));",
                  "pm.test('Today allowance math',()=>{const today=d.days.find(day=>day.date===d.date);pm.expect(today.left).to.eql(today.allowance-today.spent);});"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Saved recaps",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/recaps"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Recaps list',()=>pm.expect(Array.isArray(d)).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Disposable demo mutations",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (String(pm.environment.get('runMutations')) !== 'true') pm.execution.skipRequest();"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "08 Add 350 rupee expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/expenses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{demoDate}}\",\n  \"description\": \"Postman isolated demo dinner\",\n  \"amount\": 35000,\n  \"bucket\": \"everyday\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Expense created',()=>pm.expect(d.id).to.be.a('number'));pm.collectionVariables.set('expenseId',d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Verify expense recalculation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/today"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Daily left recalculated',()=>pm.expect(d.left).to.eql(Number(pm.collectionVariables.get('baselineLeft'))-35000));",
                  "if(String(pm.environment.get('expectSeed'))==='true')pm.test('Overspent by 50 rupees',()=>pm.expect(d.left).to.eql(-5000));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Edit expense to 200 rupees",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/expenses/{{expenseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{demoDate}}\",\n  \"description\": \"Postman isolated demo dinner\",\n  \"amount\": 20000,\n  \"bucket\": \"everyday\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Expense updated',()=>pm.expect(d.ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Verify edit",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/today"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('Edit recalculated daily left',()=>pm.expect(d.left).to.eql(Number(pm.collectionVariables.get('baselineLeft'))-20000));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Import labeled INR CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/import-csv",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"csv\": \"id,date,description,amount,currency,bucket\\npostman-fixture-01,{{demoDate}},Postman sample cinema,10.25,INR,fun\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const d=pm.response.json();",
                  "pm.test('CSV processed',()=>pm.expect(d.imported+d.duplicates).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Repeat CSV has no duplicates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
